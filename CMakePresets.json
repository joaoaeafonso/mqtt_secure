{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "dev",
      "displayName": "Debug + ASan/UBSan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MSEC_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug + ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MSEC_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Hardened release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "bench",
      "displayName": "Benchmarks (same flags as release, no sanitizers)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MSEC_BUILD_BENCHMARKS": "ON",
        "MSEC_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ci",
      "displayName": "CI: release + clang-tidy",
      "inherits": "release",
      "cacheVariables": {
        "MSEC_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer + ASan/UBSan (Clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MSEC_ENABLE_SANITIZERS": "ON",
        "MSEC_BUILD_FUZZERS": "ON",
        "MSEC_BUILD_TESTS": "OFF",
        "MSEC_BUILD_APPS": "OFF",
        "MSEC_WITH_PAHO": "OFF",
        "CMAKE_CXX_FLAGS": "-D__cpp_concepts=202002L -Wno-builtin-macro-redefined"
      },
      "description": "libstdc++ 13 only exposes std::expected when __cpp_concepts >= 202002L, which Clang 18 implements but does not advertise; the flag says so."
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "bench",
      "configurePreset": "bench"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
