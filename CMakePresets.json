{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "dev",
      "displayName": "Debug + ASan/UBSan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MSEC_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug + ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MSEC_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Hardened release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "bench",
      "displayName": "Benchmarks (same flags as release, no sanitizers)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MSEC_BUILD_BENCHMARKS": "ON",
        "MSEC_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ci",
      "displayName": "CI: release + clang-tidy",
      "inherits": "release",
      "cacheVariables": {
        "MSEC_ENABLE_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev",     "configurePreset": "dev" },
    { "name": "tsan",    "configurePreset": "tsan" },
    { "name": "release", "configurePreset": "release" },
    { "name": "bench",   "configurePreset": "bench" },
    { "name": "ci",      "configurePreset": "ci" }
  ],
  "testPresets": [
    { "name": "dev",  "configurePreset": "dev",  "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } },
    { "name": "ci",   "configurePreset": "ci",   "output": { "outputOnFailure": true } }
  ]
}
